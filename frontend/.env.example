# Copy: cp .env.example .env.local
# Local API: backend on http://localhost:3001 (see backend/.env.example)

# Server-only — Nest API base URL for BFF routes (must end with /api/v1)
API_INTERNAL_URL=http://localhost:3001/api/v1

# Public display (safe in browser)
NEXT_PUBLIC_APP_NAME=Golden Template Admin
NEXT_PUBLIC_BRAND_NAME=Golden Template
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: docs GitHub link (omit to hide icon / issue link in /docs)
# NEXT_PUBLIC_REPOSITORY_URL=https://github.com/yourorg/your-repo

# Set to true to show OAuth sign-in UI (backend OAUTH_ENABLED must match)
NEXT_PUBLIC_OAUTH_ENABLED=false

# Dev: expose /docs component catalog. Prod builds use NEXT_SERVER_MODE=prod via start script.
# NEXT_SERVER_MODE=dev

# Optional: extra img-src hosts for production CSP (space-separated origins)
# CSP_EXTRA_IMG_SRC=

# Optional error reporting (server)
# SENTRY_DSN=

# Optional OpenTelemetry (server — see instrumentation.ts)
# OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_SERVICE_NAME=website-frontend

# Playwright / CI (optional local overrides)
# PLAYWRIGHT_BASE_URL=http://localhost:3000
# PLAYWRIGHT_SKIP_WEBSERVER=
# E2E_ADMIN_EMAIL=admin@example.com
# E2E_ADMIN_PASSWORD=admin123!
# E2E_VIEWER_EMAIL=viewer@example.com
# E2E_VIEWER_PASSWORD=viewer123!
