{
  "name": "frontend",
  "version": "1.0.0",
  "private": false,
  "description": "Production-ready Next.js website template — FSD marketing home + admin dashboard with BFF httpOnly auth, MFA, RBAC",
  "author": "Tuguldur Unurtsetseg <oz.toogii@gmail.com> (https://github.com/devTugu)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/devTugu/golden-template.git"
  },
  "homepage": "https://github.com/devTugu/golden-template#readme",
  "bugs": {
    "url": "https://github.com/devTugu/golden-template/issues"
  },
  "keywords": [
    "nextjs",
    "feature-sliced-design",
    "rbac",
    "bff",
    "admin-dashboard",
    "template"
  ],
  "scripts": {
    "dev": "NEXT_SERVER_MODE=dev next dev",
    "dev:webpack": "NEXT_SERVER_MODE=dev next dev --webpack",
    "build": "next build",
    "start": "NEXT_SERVER_MODE=prod next start",
    "postinstall": "node scripts/verify-lightningcss.js",
    "lint": "eslint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:docs": "playwright test --config playwright.docs.config.ts",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@default/api": "workspace:*",
    "@default/design-tokens": "workspace:*",
    "@default/hooks": "workspace:*",
    "@default/types": "workspace:*",
    "@default/ui": "workspace:*",
    "@default/utils": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/nextjs": "^10.58.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/table-core": "^9.3.1",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.0",
    "motion": "^12.40.0",
    "lucide-react": "^0.555.0",
    "next": "^16.4.1",
    "next-intl": "^4.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.90.0",
    "react-qr-code": "^2.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.6.6",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@default/eslint-config": "workspace:*",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^2.0.1",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/semantic-conventions": "^1.34.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
