    "eslint-plugin-boundaries": "^7.2.1",
    "lightningcss": "1.33.0",
    "otplib": "^12.0.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "7.3.7",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "lightningcss-darwin-arm64": "1.33.0",
    "lightningcss-darwin-x64": "1.33.0",
    "lightningcss-linux-x64-gnu": "1.33.0"
  }
}
