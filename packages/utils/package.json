{
  "name": "@default/utils",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./dates": {
      "types": "./src/dates.ts",
      "require": "./dist/dates.js",
      "import": "./src/dates.ts",
      "default": "./src/dates.ts"
    },
    "./reading-time": {
      "types": "./src/reading-time.ts",
      "require": "./dist/reading-time.js",
      "import": "./src/reading-time.ts",
      "default": "./src/reading-time.ts"
    },
    "./color": {
      "types": "./src/color.ts",
      "require": "./dist/color.js",
      "import": "./src/color.ts",
      "default": "./src/color.ts"
    },
    "./localized": {
      "types": "./src/localized.ts",
      "require": "./dist/localized.js",
      "import": "./src/localized.ts",
      "default": "./src/localized.ts"
    },
    "./slug": {
      "types": "./src/slug.ts",
      "require": "./dist/slug.js",
      "import": "./src/slug.ts",
      "default": "./src/slug.ts"
    },
    "./user-agent": {
      "types": "./src/user-agent/device-label.ts",
      "require": "./dist/user-agent/device-label.js",
      "import": "./src/user-agent/device-label.ts",
      "default": "./src/user-agent/device-label.ts"
    },
    "./api-error-message": {
      "types": "./src/api-error-message.ts",
      "require": "./dist/api-error-message.js",
      "import": "./src/api-error-message.ts",
      "default": "./src/api-error-message.ts"
    },
    "./client-ip": {
      "types": "./src/client-ip.ts",
      "require": "./dist/client-ip.js",
      "import": "./src/client-ip.ts",
      "default": "./src/client-ip.ts"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "dates": ["./src/dates.ts"],
      "reading-time": ["./src/reading-time.ts"],
      "color": ["./src/color.ts"],
      "localized": ["./src/localized.ts"],
      "slug": ["./src/slug.ts"],
      "user-agent": ["./src/user-agent/device-label.ts"],
      "api-error-message": ["./src/api-error-message.ts"],
      "client-ip": ["./src/client-ip.ts"]
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@default/types": "workspace:*"
  },
  "devDependencies": {
    "@default/tsconfig": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "7.3.7",
    "vitest": "^5.0.5"
  }
}
