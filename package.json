{
  "name": "golden-template",
  "version": "1.3.0",
  "private": true,
  "description": "Golden Template — full-stack NestJS API + Next.js (FSD) monorepo",
  "author": "devTugu (Tuguldur Unurtsetseg)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/devTugu/golden-template.git"
  },
  "bugs": {
    "url": "https://github.com/devTugu/golden-template/issues"
  },
  "homepage": "https://github.com/devTugu/golden-template#readme",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=backend --filter=frontend",
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --filter=backend --filter=frontend --filter=@default/utils --filter=@default/api --filter=@default/types --filter=@default/hooks",
    "quality": "pnpm verify",
    "verify": "pnpm generate:tokens && pnpm --filter frontend exec node scripts/verify-lightningcss.js && pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm --filter backend run test:cov && pnpm audit",
    "audit": "pnpm audit --audit-level=high",
    "generate:domain": "node scripts/generate-domain.mjs",
    "fork:check": "bash scripts/fork-check.sh",
    "fork:rename-scope": "node scripts/fork-rename-scope.mjs",
    "test:e2e:backend": "pnpm --filter backend run test:e2e",
    "test:e2e:frontend": "API_DIR=backend bash frontend/scripts/ci-e2e.sh",
    "generate:tokens": "pnpm --filter @default/design-tokens generate",
    "infra:up": "docker compose -f backend/docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f backend/docker-compose.dev.yml down"
  },
  "devDependencies": {
    "turbo": "^2.5.4"
  },
  "pnpm": {
    "overrides": {
      "@opentelemetry/auto-instrumentations-node": ">=0.77.0",
      "@opentelemetry/exporter-prometheus": ">=0.217.0",
      "@opentelemetry/propagator-jaeger": ">=2.9.0",
      "@opentelemetry/sdk-node": ">=0.217.0",
      "@xmldom/xmldom": ">=0.9.12",
      "basic-ftp": ">=6.2.1",
      "esbuild": ">=0.25.0",
      "handlebars": ">=4.7.10",
      "js-yaml": ">=5.4.1",
      "katex": ">=0.18.2",
      "markdown-it": ">=14.3.3",
      "nodemailer": ">=10.0.6",
      "uuid": ">=11.1.1",
      "vite": "7.3.7",
      "body-parser": ">=2.4.0",
      "multer": ">=2.5.0"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    }
  }
}
