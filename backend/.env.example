# Copy: cp .env.example .env
# Postgres + Redis: pnpm infra:up (from repo root)
# Then: pnpm --filter backend run db:setup
# (db:ensure creates DB_NAME on local Postgres if missing; Docker compose creates app_db automatically)

# PostgreSQL — matches backend/docker-compose.dev.yml
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=app_user
DB_PASSWORD=app_password
DB_NAME=app_db
DB_SSL=false

NODE_ENV=development
APP_PORT=3001

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars

CORS_ORIGIN=http://localhost:3000

REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379

SWAGGER_ENABLED=true
LOG_LEVEL=info

# Seed credentials (admin login after seed)
SEED_ADMIN_EMAIL=admin@default.mn
SEED_ADMIN_PASSWORD=admin123!
SEED_VIEWER_EMAIL=viewer@default.mn
SEED_VIEWER_PASSWORD=viewer123!

# Required when a user enrolls MFA (TOTP at rest). Platform MFA policy: Dashboard → Security.
MFA_ENCRYPTION_KEY=change_me_mfa_encryption_key_min_32_chars
# Optional: comma-separated roles when platform policy is ON (default SUPER_ADMIN)
# MFA_REQUIRED_ROLES=

PASSWORD_RESET_TTL_MINUTES=60
INVITE_TTL_HOURS=72
MEDIA_MAX_BYTES=5242880
# E2E/dev: capture reset/invite URLs at GET /api/v1/dev/notifications/reset
NOTIFICATION_CAPTURE=false

# Production, OAuth, SMTP, S3, OTEL, Sentry — see md/deploy.md
# Full schema: backend/src/infrastructure/config/env.validation.ts
