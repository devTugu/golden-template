{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@default/ui#build": {
      "dependsOn": ["@default/design-tokens#build", "@default/ui-charts#build"],
      "outputs": ["dist/**"]
    },
    "@default/ui-code#build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "cache": false
    },
    "typecheck": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "test:e2e": {
      "cache": false
    },
    "generate": {
      "cache": false
    }
  }
}
